---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-top">
      <div>
        <p class="eyebrow">Ready when you are</p>
        <h2 class="h-section">Let's simplify your accounting.</h2>
        <p class="lede">
          A 30-minute call to understand your books, your close calendar and where
          the friction is. No obligation, no pitch deck.
        </p>
        <div class="btn-row" style="margin-top: 2rem;">
          <a class="btn btn--primary" href={`${base}contact/`}>Book a discovery call</a>
          <a class="btn btn--ghost" href="mailto:info@accbaseadvisory.com">Email us</a>
        </div>
      </div>

      <dl class="foot-contact">
        <div><dt>Email</dt><dd><a href="mailto:info@accbaseadvisory.com">info@accbaseadvisory.com</a></dd></div>
        <div><dt>Phone</dt><dd><a href="tel:+919844004735">+91 98440 04735</a></dd></div>
        <div><dt>Hours</dt><dd>Overlapping US business hours, Mon–Fri</dd></div>
        <div><dt>LinkedIn</dt><dd><a href="https://www.linkedin.com/company/accbase-advisory/" target="_blank" rel="noopener noreferrer">Follow us</a></dd></div>
      </dl>
    </div>

    <nav class="foot-nav" aria-label="Footer">
      <div>
        <h3>Services</h3>
        <a href={`${base}services/accounting-bookkeeping/`}>Accounting &amp; bookkeeping</a>
        <a href={`${base}services/financial-reporting/`}>Financial reporting</a>
        <a href={`${base}services/payroll-compliance/`}>Payroll &amp; compliance</a>
        <a href={`${base}services/advisory-fpa/`}>Advisory &amp; FP&amp;A</a>
        <a href={`${base}services/offshore-finance-teams/`}>Offshore finance teams</a>
      </div>
      <div>
        <h3>Industries</h3>
        <a href={`${base}industries/saas-technology/`}>SaaS &amp; technology</a>
        <a href={`${base}industries/ecommerce-retail/`}>E-commerce &amp; retail</a>
        <a href={`${base}industries/professional-services/`}>Professional services</a>
        <a href={`${base}industries/healthcare/`}>Healthcare</a>
      </div>
      <div>
        <h3>Company</h3>
        <a href={`${base}how-we-work/`}>How we work</a>
        <a href={`${base}about/`}>About</a>
        <a href={`${base}insights/`}>Insights</a>
        <a href={`${base}contact/`}>Contact</a>
      </div>
      <div>
        <h3>Legal</h3>
        <a href={`${base}privacy/`}>Privacy policy</a>
        <a href={`${base}terms/`}>Terms of use</a>
      </div>
    </nav>

    <p class="foot-base">
      &copy; {year} Accbase Advisory. Offshore accounting and financial advisory.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgba(246, 243, 238, 0.72);
    padding-block: clamp(4rem, 8vw, 7rem) 3rem;
  }
  .site-footer h2, .site-footer h3 { color: var(--paper); }
  .site-footer .eyebrow { color: var(--gold); }
  .site-footer .lede { color: rgba(246, 243, 238, 0.78); margin: 1.25rem 0 0; }
  .site-footer .btn--primary { background: var(--gold); color: var(--ink); }
  .site-footer .btn--primary:hover { background: var(--paper); }
  .site-footer .btn--ghost { border-color: var(--rule-invert); color: var(--paper); }
  .site-footer .btn--ghost:hover { background: var(--paper); color: var(--ink); }

  .foot-top {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--rule-invert);
  }
  .foot-top .eyebrow { margin-bottom: 1.25rem; }

  .foot-contact { margin: 0; display: grid; gap: 1.5rem; align-content: start; }
  .foot-contact dt {
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.4rem;
  }
  .foot-contact dd { margin: 0; font-size: 0.9375rem; color: var(--paper); }
  .foot-contact a { text-decoration: none; }
  .foot-contact a:hover { color: var(--gold); }

  .foot-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .foot-nav h3 {
    font-family: var(--body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 1.1rem;
  }
  .foot-nav a {
    display: block;
    font-size: 0.9375rem;
    text-decoration: none;
    padding: 0.35rem 0;
  }
  .foot-nav a:hover { color: var(--gold); }

  .foot-base {
    margin: 0;
    padding-top: 2rem;
    border-top: 1px solid var(--rule-invert);
    font-size: 0.8125rem;
    color: rgba(246, 243, 238, 0.5);
  }

  @media (max-width: 860px) {
    .foot-top { grid-template-columns: 1fr; }
    .foot-nav { grid-template-columns: repeat(2, 1fr); gap: 2rem 1.5rem; }
  }
</style>
