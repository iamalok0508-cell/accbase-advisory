---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const partners = [
  {
    name: 'Nithyashree S',
    credential: 'FCA',
    role: 'Partner — Accounting & Operations',
    bio: 'A Chartered Accountant with experience across multiple industries, including global operations and cash management. At Accbase, she leads day-to-day accounting delivery — bookkeeping, reconciliations and the month-end close — so clients get accurate books on a fixed calendar.',
  },
  {
    name: 'Alok Sharma',
    credential: 'CA',
    role: 'Partner — Advisory & FP&A',
    bio: 'A Chartered Accountant focused on management reporting and financial planning. At Accbase, he leads advisory work — budgeting, forecasting, cash-flow planning and MIS — and works with each client to scope the right engagement as their business grows.',
  },
  {
    name: 'Chandra Mouli',
    credential: 'CA, CMA',
    role: 'Partner — Audit, Controls & Compliance',
    bio: 'A Chartered Accountant and Cost & Management Accountant with experience across statutory audit, taxation, record-to-report operations, revenue recognition and international reporting standards. At Accbase, he helps businesses maintain accurate books, strengthen internal controls and build reliable financial reporting systems.',
  },
];

const values = [
  ['Expertise', 'Chartered and semi-qualified accountants doing accounting work, not data entry dressed up as it.'],
  ['Integrity', 'We tell you when the numbers are wrong, including when they are wrong because of us.'],
  ['Client-first', 'We work to your calendar and your systems, not the other way round.'],
];
---
<BaseLayout
  title="About Accbase Advisory"
  description="Accbase Advisory is an offshore accounting and financial advisory firm helping growing businesses run accurate books, report on time, and scale their finance function without scaling headcount."
>
  <PageHero
    eyebrow="About"
    title="An offshore finance team built to work like an in-house one."
    lede="Accbase Advisory helps growing businesses run accurate books, report on time, and scale their finance function without scaling headcount."
  />

  <section class="section">
    <div class="wrap">
      <p class="mission">
        Our mission is to give businesses reliable, accurate and scalable accounting &mdash;
        simplifying financial operations and enabling informed decisions through
        expertise, integrity and a client-first approach.
      </p>
    </div>
  </section>

  <section class="section section--sand">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Meet the partners</p><h2 class="h-section">Who you'll be working with</h2></div></div>
      <div class="grid grid-3">
        {partners.map((p) => (
          <div class="cell partner">
            <h3 class="h-card">{p.name}</h3>
            <p class="partner-credential">{p.credential}</p>
            <p class="partner-role">{p.role}</p>
            <p>{p.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">How we operate</p><h2 class="h-section">Three things we hold to</h2></div></div>
      <div class="grid grid-3">
        {values.map(([title, copy]) => (
          <div class="cell"><h3 class="h-card">{title}</h3><p>{copy}</p></div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mission {
    font-family: var(--display);
    font-size: clamp(1.375rem, 3vw, 2.25rem);
    font-weight: 500; line-height: 1.32; letter-spacing: -0.024em;
    color: var(--ink); max-width: 30ch; margin: 0;
    padding-left: clamp(1rem, 3vw, 2.5rem); border-left: 2px solid var(--gold);
  }
  .partner-credential {
    color: var(--gold);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0.5rem 0 0;
  }
  .partner-role { color: var(--bronze); font-weight: 600; font-size: 0.875rem; margin: 0.2rem 0 0.9rem; }
</style>
